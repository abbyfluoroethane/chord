{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chord",
  "version": "0.1.0",
  "identifier": "space.foid.chord",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Chord",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob: chord-avatar: http://chord-avatar.localhost chord-emoji: http://chord-emoji.localhost; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xmpp"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
